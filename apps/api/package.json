{
  "name": "@marcia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "generate-types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "node scripts/deploy-blocked.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "wrangler": "4.167.0"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.27",
    "better-auth": "1.7.27",
    "zod": "4.6.7"
  }
}
